POSTGRES_PASSWORD=change-me
GRAFANA_DB_PASSWORD=change-me-too
GRAFANA_ADMIN_PASSWORD=change-me-admin
# 포트를 열 인터페이스. 공인 IP 에 MLflow(무인증)가 노출되지 않도록 사설/Tailscale IP 를 지정.
BIND_IP=127.0.0.1
GRAFANA_PORT=3000
# MLflow 3 은 localhost + RFC1918 사설 IP 만 기본 허용. Tailscale(100.64/10)이나 호스트명은 여기에 추가.
# 값을 지정하면 기본값을 대체하므로, SSH 터널(localhost:임의포트)용으로 localhost:* 도 함께 넣는다.
# 예: MLFLOW_ALLOWED_HOSTS=<mlflow-host>:5000,<mlflow-host>,localhost,localhost:*,127.0.0.1,127.0.0.1:*
MLFLOW_ALLOWED_HOSTS=
